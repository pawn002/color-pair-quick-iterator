{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/main.ts",
    "src/styles.scss",
    "src/app/app.ts",
    "src/app/app.scss",
    "src/app/services/declarations.d.ts",
    "src/app/services/color-util.service.ts",
    "src/app/services/color-metrics.service.ts",
    "src/app/services/bpca.service.ts",
    "src/app/_candor/accordion/accordion-item.ts",
    "src/app/_candor/button/button.ts",
    "src/app/_candor/card/card.ts",
    "src/app/_candor/form/checkbox/checkbox.ts",
    "src/app/_candor/form/radio/radio.ts",
    "src/app/_candor/modal/modal.ts",
    "src/app/_candor/table/table.ts",
    "src/app/_candor/toast/toast.ts",
    "src/app/_candor/tooltip/tooltip.ts",
    "src/app/_components/alert/alert.ts",
    "src/app/_components/alert/alert.stories.ts",
    "src/app/_components/color-contrast/color-contrast.ts",
    "src/app/_components/color-contrast/color-contrast.stories.ts",
    "src/app/_components/color-picker/color-picker.ts",
    "src/app/_components/color-picker/color-picker.stories.ts",
    "src/app/_components/color-slider/color-slider.ts",
    "src/app/_components/color-slider/color-slider.stories.ts",
    "src/app/_components/copy-to-clipboard-button/copy-to-clipboard-button.ts",
    "src/app/_components/copy-to-clipboard-button/copy-to-clipboard-button.stories.ts",
    "src/app/_components/metadata/metadata.ts",
    "src/app/_components/metadata/metadata.stories.ts",
    "src/app/_components/palette-table/palette-table.ts",
    "src/app/_components/tone-picker/tone-picker.ts",
    ".storybook/main.ts",
    ".storybook/preview.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
